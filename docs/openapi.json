{"openapi":"3.1.0","info":{"title":"星河游乐场订票 API","description":"前后端分离的订票接口。金额单位为元，日期格式 yyyy-MM-dd，时间为本地时间且不带时区。\n订单状态：UNPAID 待支付，PAID 已支付，CANCELLED 已取消。\n仅 UNPAID 可以支付或取消；取消会退回当日余票。单笔 1 到 10 张，可订今天起 30 天内（含第 30 天）。\n创建订单时未知 JSON 字段会被忽略。字段校验失败时 details 给出 field 与 message。\n","version":"1.0.0"},"servers":[{"url":"http://localhost:8080","description":"本地后端"}],"paths":{"/api/orders":{"get":{"tags":["订单"],"summary":"按手机号查询订单","description":"phone 必填，精确匹配下单手机号。没有订单时返回空数组。","operationId":"list","parameters":[{"name":"phone","in":"query","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"订单列表，没有订单时为空数组","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/OrderView"}}}}},"400":{"description":"缺少手机号或格式不正确","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}}}},"post":{"tags":["订单"],"summary":"创建订单","description":"按下单数量占用当日余票。仅待支付订单占用余票。","operationId":"create","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateOrderRequest"}}},"required":true},"responses":{"201":{"description":"已创建，Location 指向订单详情","content":{"application/json":{"schema":{"$ref":"#/components/schemas/OrderView"}}}},"400":{"description":"字段不合法、日期超范围或 JSON 无法解析","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"404":{"description":"游乐项目不存在","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"409":{"description":"余票不足，code 为 SOLD_OUT","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}}}}},"/api/orders/{orderNo}/pay":{"post":{"tags":["订单"],"summary":"支付订单","description":"只有 UNPAID 可以支付，成功后状态变为 PAID。","operationId":"pay","parameters":[{"name":"orderNo","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"已支付","content":{"application/json":{"schema":{"$ref":"#/components/schemas/OrderView"}}}},"404":{"description":"订单不存在","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"409":{"description":"当前状态不能支付，code 为 ILLEGAL_STATE","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}}}}},"/api/orders/{orderNo}/cancel":{"post":{"tags":["订单"],"summary":"取消订单","description":"只有 UNPAID 可以取消。取消后状态变为 CANCELLED，并退回当日余票。","operationId":"cancel","parameters":[{"name":"orderNo","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"已取消","content":{"application/json":{"schema":{"$ref":"#/components/schemas/OrderView"}}}},"404":{"description":"订单不存在","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"409":{"description":"当前状态不能取消，code 为 ILLEGAL_STATE","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}}}}},"/api/orders/{orderNo}":{"get":{"tags":["订单"],"summary":"订单详情","operationId":"get","parameters":[{"name":"orderNo","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"订单详情","content":{"application/json":{"schema":{"$ref":"#/components/schemas/OrderView"}}}},"404":{"description":"订单不存在","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}}}}},"/api/attractions":{"get":{"tags":["游乐项目"],"summary":"项目列表","description":"category 精确匹配分类编码；keyword 按项目名称包含匹配，忽略大小写。都不传则返回全部。","operationId":"list_1","parameters":[{"name":"category","in":"query","description":"THRILL、FAMILY、WATER、SHOW","required":false,"schema":{"type":"string"}},{"name":"keyword","in":"query","description":"项目名称关键字","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"项目列表","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/AttractionView"}}}}},"400":{"description":"category 不是已知分类","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}}}}},"/api/attractions/{id}":{"get":{"tags":["游乐项目"],"summary":"项目详情","operationId":"get_1","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"项目详情","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AttractionView"}}}},"400":{"description":"id 不是数字","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"404":{"description":"游乐项目不存在","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}}}}},"/api/attractions/{id}/availability":{"get":{"tags":["游乐项目"],"summary":"查询某日余票","description":"date 必填，格式 yyyy-MM-dd。过去的日期和超过今天之后 30 天的日期都会拒绝。","operationId":"availability","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"date","in":"query","required":true,"schema":{"type":"string","format":"date"}}],"responses":{"200":{"description":"当日余票","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AvailabilityView"}}}},"400":{"description":"日期缺失、格式错误或超出可订范围","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"404":{"description":"游乐项目不存在","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}}}}},"/api/attractions/categories":{"get":{"tags":["游乐项目"],"summary":"项目分类","description":"返回全部分类编码和中文名称，供筛选使用。","operationId":"categories","responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/CategoryView"}}}}}}}}},"components":{"schemas":{"CreateOrderRequest":{"type":"object","description":"创建订单。未知字段会被忽略。姓名和手机号会先去掉首尾空格。","properties":{"attractionId":{"type":"integer","format":"int64","example":1},"visitDate":{"type":"string","format":"date","description":"yyyy-MM-dd，今天起 30 天内","example":"2026-09-25"},"quantity":{"type":"integer","format":"int32","example":2,"maximum":10,"minimum":1},"visitorName":{"type":"string","description":"不能包含数字，包括全角数字","example":"张三","maxLength":20,"minLength":0,"pattern":"^[^0-9０-９]+$"},"visitorPhone":{"type":"string","example":"13800138000","minLength":1,"pattern":"^1\\d{10}$"}},"required":["attractionId","quantity","visitDate","visitorName","visitorPhone"]},"OrderView":{"type":"object","description":"订单","properties":{"orderNo":{"type":"string","description":"订单号，PK + 下单日期 yyyyMMdd + 4 位序号","example":"PK202609240001"},"attractionId":{"type":"integer","format":"int64"},"attractionName":{"type":"string"},"visitDate":{"type":"string","format":"date"},"quantity":{"type":"integer","format":"int32"},"unitPrice":{"type":"number","description":"单价，元"},"totalAmount":{"type":"number","description":"总价，元，等于单价乘以数量"},"visitorName":{"type":"string"},"visitorPhone":{"type":"string"},"status":{"type":"string","description":"UNPAID、PAID、CANCELLED"},"statusLabel":{"type":"string"},"createdAt":{"type":"string","format":"date-time","description":"本地时间，无时区后缀"}}},"AttractionView":{"type":"object","description":"游乐项目","properties":{"id":{"type":"integer","format":"int64","example":1},"name":{"type":"string","example":"极速云霄"},"category":{"type":"string","description":"THRILL、FAMILY、WATER、SHOW","example":"THRILL"},"categoryLabel":{"type":"string","example":"刺激项目"},"description":{"type":"string"},"price":{"type":"number","description":"单价，元","example":88.0},"dailyQuota":{"type":"integer","format":"int32","description":"每个游玩日的可售张数","example":80},"minHeightCm":{"type":"integer","format":"int32","description":"0 表示无身高限制","example":140},"durationMinutes":{"type":"integer","format":"int32","description":"体验时长，分钟","example":3},"openTime":{"type":"string","description":"开放时间 HH:mm","example":"10:00"},"closeTime":{"type":"string","description":"关闭时间 HH:mm","example":"20:30"}}},"AvailabilityView":{"type":"object","description":"某一天的余票","properties":{"attractionId":{"type":"integer","format":"int64"},"date":{"type":"string","format":"date","example":"2026-09-25"},"dailyQuota":{"type":"integer","format":"int32"},"sold":{"type":"integer","format":"int32"},"remaining":{"type":"integer","format":"int32"}}},"CategoryView":{"type":"object","description":"项目分类","properties":{"code":{"type":"string","example":"THRILL"},"label":{"type":"string","example":"刺激项目"}}},"ApiError":{"description":"失败时的响应体。2xx 不会使用这个结构。","properties":{"code":{"type":"string"},"message":{"type":"string"},"details":{"type":"array","items":{"$ref":"#/components/schemas/FieldViolation"}},"path":{"type":"string"},"timestamp":{"type":"string"}}},"FieldViolation":{"description":"字段级错误","properties":{"field":{"type":"string","example":"visitorPhone"},"message":{"type":"string","example":"手机号须为 1 开头的 11 位数字"}}}}}}